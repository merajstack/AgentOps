```gitignore
# =========================
# Dependencies
# =========================
node_modules/
jspm_packages/
bower_components/

# =========================
# Next.js
# =========================
.next/
out/
.vercel/
.turbo/

# =========================
# Build output
# =========================
dist/
build/
coverage/
.cache/
tmp/
temp/

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Environment variables
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# =========================
# TypeScript
# =========================
*.tsbuildinfo

# =========================
# Package managers
# =========================
.pnpm-store/
.npm/
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
!.yarn/patches
!.yarnrc.yml

# =========================
# IDEs & Editors
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# Runtime files
# =========================
*.pid
*.seed
*.pid.lock

# =========================
# Testing
# =========================
coverage/
.nyc_output/

# Jest
jest-html-reporters-*.html

# Playwright
playwright-report/
test-results/

# Cypress
cypress/videos/
cypress/screenshots/

# =========================
# ESLint
# =========================
.eslintcache

# =========================
# Misc
# =========================
*.local

# =========================
# Archives
# =========================
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# =========================
# Optional
# =========================
*.pem
*.key
*.crt
```
.next/
